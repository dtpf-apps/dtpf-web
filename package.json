    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react-swc": "~4.3.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "~8.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "~6.1.1",
    "vitest": "^4.1.0",

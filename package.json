{
  "name": "dtpf-web",
  "version": "0.7.2",
  "description": "Frontend of dtpf.es, the personal portfolio of David T. Pizarro Frick",
  "author": "David T. Pizarro Frick",
  "license": "MIT",
  "homepage": "https://dtpf.es",
  "repository": {
    "type": "git",
    "url": "https://github.com/dtpf-apps/dtpf-web.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^14.2.0",
    "i18next": "^26.4.4",
    "lucide-react": "^1.56.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "~8.4.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/postbuild/index.mjs",
    "postbuild:check": "node scripts/postbuild/check.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings src test scripts vite.config.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"test/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"test/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" vite.config.ts"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 110,
    "tabWidth": 2
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react-swc": "~4.3.3",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "playwright": "1.64.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "~8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
